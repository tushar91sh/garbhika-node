{
  "name": "garbhika-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "test": "node --test test/*.test.js",
    "seed": "node src/scripts/seed.js",
    "admin:make": "node src/scripts/make-admin.js",
    "admin:reset-password": "node src/scripts/reset-password.js",
    "backup": "bash scripts/backup.sh",
    "test:integration": "node --test integration/*.mjs",
    "care:migrate": "node scripts/care-migrate.mjs",
    "test:care": "node --test test/care.test.js",
    "push:keys": "node -e \"console.log(require('web-push').generateVAPIDKeys())\"",
    "test:care:integration": "node --test integration/care.integration.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "morgan": "^1.10.1",
    "nodemailer": "^7.0.6",
    "socket.io": "^4.8.1",
    "web-push": "^3.6.7",
    "@aws-sdk/client-s3": "^3.900.0",
    "@aws-sdk/s3-request-presigner": "^3.900.0",
    "@aws-sdk/client-kms": "^3.900.0",
    "bullmq": "^5.58.0",
    "ioredis": "^5.7.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.1.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
