NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/garbhika
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
# Bypass works ONLY with NODE_ENV=development. Set false in production.
OTP_DEV_BYPASS=true
ADMIN_USERNAME=garbhika-admin
ADMIN_EMAIL=admin@garbhika.com
ADMIN_PASSWORD=replace-with-your-own-strong-password
# Optional bcrypt hash instead of ADMIN_PASSWORD. Takes precedence.
ADMIN_PASSWORD_HASH=
# Required in production: Brevo API key and a verified sender email.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
# Optional SMTP for development password-reset/booking emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Garbhika <no-reply@garbhika.com>
NOTIFICATION_EMAIL=hello@garbhika.com
